# Database (local: XAMPP MariaDB; host: set in DirectAdmin > Node.js app > Environment variables)
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# Local API port (Next dev server proxies /api/v1 to it)
API_PORT=4000

# Shared secret the deploy pipeline uses to restart the app (also a GitHub Actions secret)
RESTART_TOKEN=

# Public address of the site (OAuth redirect URI + CSRF check). Local: leave empty (http://localhost:3000).
SITE_URL=

# First Super Admin. Prefer a CMU account (promoted when they first sign in with CMU Account).
BOOTSTRAP_ADMIN_CMU_EMAILS=
# Or a local account, created once at startup if missing. Remove the password from the environment afterwards.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# CMU Account OAuth (login with @cmu.ac.th). Leave the id/secret empty to hide the button.
# Redirect URI to register with CMU: <SITE_URL>/api/v1/auth/cmu/callback
CMU_OAUTH_CLIENT_ID=
CMU_OAUTH_CLIENT_SECRET=
# Defaults below are unverified; confirm against the documentation CMU gives you when you register the app.
CMU_OAUTH_AUTHORIZE_URL=
CMU_OAUTH_TOKEN_URL=
CMU_OAUTH_USERINFO_URL=
CMU_OAUTH_SCOPE=
CMU_OAUTH_EMAIL_FIELD=
